# ============================================================
# CACHÉ EFICIENTE PARA ASSETS ESTÁTICOS (PageSpeed Optimization)
# ============================================================

# --- Imágenes: caché de 1 año (365 días = 31536000 seg) ---
<IfModule mod_headers.c>
    <FilesMatch "\.(webp|jpg|jpeg|png|gif|ico|svg|avif)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # --- Fuentes: caché de 1 año ---
    <FilesMatch "\.(woff|woff2|ttf|otf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # --- CSS y JS: caché de 1 mes (2592000 seg) ---
    # Si necesitas invalidar caché, agrega ?v=2 al enlace del archivo
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # --- Videos: caché de 1 año ---
    <FilesMatch "\.(mp4|webm|ogv|ogg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # --- PDF y documentos: caché de 1 mes ---
    <FilesMatch "\.(pdf|doc|docx)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

# ============================================================
# COMPRESIÓN GZIP/BROTLI (reduce tamaño de transferencia)
# ============================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE application/font-woff
    AddOutputFilterByType DEFLATE application/font-woff2
</IfModule>

# ============================================================
# EXPIRES MODULE (respaldo si mod_headers no está disponible)
# ============================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType video/webm "access plus 1 year"
    ExpiresByType video/ogg "access plus 1 year"
</IfModule>

Options +SymLinksIfOwnerMatch
Options -Multiviews
Options -Indexes

RewriteEngine on
RewriteBase /

# 🔒 Forzar HTTPS
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-SSL} !on
RewriteCond %{HTTP_HOST} ^porttainobay\.com$ [OR]
RewriteCond %{HTTP_HOST} ^www\.porttainobay\.com$
RewriteRule ^(.*)$ https://porttainobay.com/$1 [R=301,L]

# ✅ Respetar archivos y carpetas reales (excepto carpetas de idioma)
RewriteCond %{REQUEST_URI} !^/(en|es)/
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Home
RewriteRule ^/$ index.php [L]
# ✅ FIX ESPECÍFICO
RewriteRule ^(en|es)/port-experience/?$ port-experience.php?lang=$1 [QSA,L]
# ✅ LÍNEA NUEVA — Port experience dinámico CON idioma
RewriteRule ^(en|es)/port-experience/([^/]+)/?$ single-port-experience.php?point=$2&lang=$1 [QSA,L]
# ✅ FIX: idioma SOLO para rutas simples (NO profundas)
RewriteRule ^(en|es)/([^/]+)$ $2.php?lang=$1 [QSA,L]

# Port experience dinámico
RewriteRule ^port-experience/([^/]+)$ single-port-experience.php?point=$1 [L,QSA]

# Blog
RewriteRule ^blog/([^/]+)$ blog.php?title=$1 [L,QSA]

# Seguridad
RedirectMatch 403 ^/vendor/.*$

<FilesMatch "^(composer\.(json|lock)|launch\.json|package\.json|package-lock\.json|yarn\.lock|\.env)$">
    Require all denied
</FilesMatch>

# 404
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /en/404 [L,QSA]

# MIME
AddType video/ogg .ogv
AddType video/mp4 .mp4
AddType video/webm .webm

# PHP handler
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>