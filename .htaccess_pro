# Evitar caché para CSS y JS
<FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
</FilesMatch>

Options +SymLinksIfOwnerMatch
Options -Multiviews
Options -Indexes

RewriteEngine on
RewriteBase /

# 🔒 Forzar HTTPS
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-SSL} !on
RewriteCond %{HTTP_HOST} ^porttainobay\.com$ [OR]
RewriteCond %{HTTP_HOST} ^www\.porttainobay\.com$
RewriteRule ^(.*)$ https://porttainobay.com/$1 [R=301,L]

# ✅ Respetar archivos y carpetas reales (excepto carpetas de idioma)
RewriteCond %{REQUEST_URI} !^/(en|es)/
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Home
RewriteRule ^/$ index.php [L]
# ✅ FIX ESPECÍFICO
RewriteRule ^(en|es)/port-experience/?$ port-experience.php?lang=$1 [QSA,L]
# ✅ LÍNEA NUEVA — Port experience dinámico CON idioma
RewriteRule ^(en|es)/port-experience/([^/]+)/?$ single-port-experience.php?point=$2&lang=$1 [QSA,L]
# ✅ FIX: idioma SOLO para rutas simples (NO profundas)
RewriteRule ^(en|es)/([^/]+)$ $2.php?lang=$1 [QSA,L]

# Port experience dinámico
RewriteRule ^port-experience/([^/]+)$ single-port-experience.php?point=$1 [L,QSA]

# Blog
RewriteRule ^blog/([^/]+)$ blog.php?title=$1 [L,QSA]

# Seguridad
RedirectMatch 403 ^/vendor/.*$

<FilesMatch "^(composer\.(json|lock)|launch\.json|package\.json|package-lock\.json|yarn\.lock|\.env)$">
    Require all denied
</FilesMatch>

# 404
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /en/404 [L,QSA]

# MIME
AddType video/ogg .ogv
AddType video/mp4 .mp4
AddType video/webm .webm

# PHP handler
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
</IfModule>